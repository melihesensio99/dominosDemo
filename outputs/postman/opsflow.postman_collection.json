{
  "info": {
    "_postman_id": "1b8f0b8f-9b47-4c9d-9a42-4c4ef78d9d0a",
    "name": "OpsFlow MVP Flow",
    "description": "OpsFlow MVP alisveris akisinin Gateway uzerinden adim adim test edilmesi icin sade Postman koleksiyonu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Gateway",
      "item": [
        {
          "name": "Servis Haritasini Kontrol Et",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/services",
              "host": ["{{gateway_url}}"],
              "path": ["services"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Auth",
      "item": [
        {
          "name": "Deneme Kullanıcısı Oluştur",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('test_email')) {",
                  "  pm.environment.set('test_email', `opsflow.demo.${Date.now()}@example.com`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('token', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"confirmPassword\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proxy/auth/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "auth", "auth", "register"]
            }
          }
        },
        {
          "name": "Deneme Kullanıcısı ile Giriş Yap",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('token', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proxy/auth/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "auth", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Catalog",
      "item": [
        {
          "name": "Bir Kategori Oluştur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('category_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MVP Pizzalar\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proxy/catalog/categories",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "catalog", "categories"]
            }
          }
        },
        {
          "name": "Bir Ürün Oluştur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('product_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MVP Karışık Pizza\",\n  \"description\": \"Postman ile eklenen deneme ürünü\",\n  \"price\": 249.90,\n  \"stock\": 20,\n  \"categoryId\": \"{{category_id}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proxy/catalog/products",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "catalog", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Inventory",
      "item": [
        {
          "name": "Otomatik Oluşan Ürün Stoğunu Kontrol Et",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/proxy/inventory/stock/{{product_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "inventory", "stock", "{{product_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Basket",
      "item": [
        {
          "name": "Ürünü Sepete Ekle",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proxy/basket/baskets/me/items",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "basket", "baskets", "me", "items"]
            }
          }
        },
        {
          "name": "Sepeti Görüntüle",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/proxy/basket/baskets/me",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "basket", "baskets", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Order",
      "item": [
        {
          "name": "Sipariş Oluştur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('order_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"Ataturk Caddesi 10\",\n    \"district\": \"Kadikoy\",\n    \"city\": \"Istanbul\",\n    \"postalCode\": \"34710\",\n    \"country\": \"Turkiye\"\n  },\n  \"billingAddress\": {\n    \"street\": \"Ataturk Caddesi 10\",\n    \"district\": \"Kadikoy\",\n    \"city\": \"Istanbul\",\n    \"postalCode\": \"34710\",\n    \"country\": \"Turkiye\"\n  },\n  \"paymentMethod\": 0\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/proxy/order/orders",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "order", "orders"]
            }
          }
        },
        {
          "name": "Siparişlerimi Görüntüle",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{gateway_url}}/proxy/order/orders/me",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "order", "orders", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Notification",
      "item": [
        {
          "name": "Bildirimleri Görüntüle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/proxy/notification/notifications",
              "host": ["{{gateway_url}}"],
              "path": ["proxy", "notification", "notifications"]
            }
          }
        }
      ]
    }
  ]
}
